# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments (venv, env, .venv)
venv/
env/
.venv/
ENV/

# IDE configurations (PyCharm, VS Code)
.idea/
.vscode/
*.swp
*.swo

# Streamlit config / local cache
.streamlit/

# Tests
src/analysis/test_analysis_suite.py

# ==========================================
# MULTI-PROJECT & RUNTIME DATA IGNORING
# ==========================================
# Ignore all user-created project workspaces
data/projects/*
!data/projects/.gitkeep

# Ignore legacy or root-level fallback folders
data/runs/*
data/analysis_runs/*
data/evaluation_presets/*
data/weight_presets/*

# Ensure core directory structures stay tracked if desired
!data/runs/.gitkeep
!data/analysis_runs/.gitkeep